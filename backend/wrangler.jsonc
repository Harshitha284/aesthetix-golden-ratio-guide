{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "umax-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "umax-db",
      "database_id": "local-umax-db"
    }
  ]
}
